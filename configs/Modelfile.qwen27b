# Modelfile for Qwen 3.8 27B
# Fixes the Ollama 4K Context Trap and configures reasoning effort

FROM /models/qwen3.8-27b/qwen3.8-27b-q4_k_m.gguf

# 1. Expand context window from 4k to 64k tokens
PARAMETER num_ctx 65536

# 2. Flash Attention & Prediction Window
PARAMETER flash_attention true
PARAMETER num_predict 16384

# 3. Control Thinking / Reasoning Effort (low, medium, high)
# Prevents model from spending 20k tokens thinking on routine tasks
PARAMETER reasoning_effort medium

# 4. Sampling Hyperparameters
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER repeat_penalty 1.05

SYSTEM """You are an expert autonomous software engineer and pair programmer. You provide verified, production-ready code with complete implementations and clear explanations."""
